# Pix Payment Configuration
VITE_PIX_RECIPIENT_NAME="Artes Indígenas"
VITE_PIX_RECIPIENT_CITY="São Paulo"
VITE_PIX_RECIPIENT_KEY="email@example.com"
VITE_PIX_API_URL="https://gerarqrcodepix.com.br/api/v1"

# Contact Information (used as fallback when the sheet doesn't override)
VITE_WHATSAPP_NUMBER="5511999999999" # Format: country code + area code + number, no spaces or symbols
VITE_WHATSAPP_MESSAGE="Olá! Gostaria de saber mais sobre os produtos."

# Google Spreadsheet CMS (optional)
# When set, products are loaded from the Produtos tab and site-wide content
# (hero, about, footer, branding, SEO, theme) is loaded from the Conteudo_Site tab.
# Share the sheet as "Anyone with the link can view" so opensheet can read it.
# Both English (key/value, name, price, ...) and pt-BR (chave/valor, nome, preco, ...)
# column schemas are supported transparently.
VITE_GOOGLE_SPREADSHEET_ID="1Q-WB2FsC-M3aRz9LdSdacoBKYccz2SgKUjfsE13XQUo"
VITE_GOOGLE_SPREADSHEET_TAB="Produtos"
VITE_GOOGLE_SPREADSHEET_CONTENT_TAB="Conteudo_Site"
