# Contact fallback (prefer the Conteudo_Site spreadsheet).
# Leave empty when unknown — the app hides WhatsApp features instead of
# showing a placeholder number.
VITE_WHATSAPP_NUMBER="" # Format: country code + area code + number, digits only
VITE_WHATSAPP_MESSAGE=""

# Google Spreadsheet CMS
# Products are loaded from the Produtos tab and site-wide content
# (branding, navigation labels, catalog texts, ordering notices, contact,
# language/currency/locale, theme, SEO) from the Conteudo_Site tab.
# Share the sheet as "Anyone with the link can view" so opensheet can read it.
# Both English (key/value, name, price, ...) and pt-BR (chave/valor, nome, preco, ...)
# column schemas are supported transparently.
VITE_GOOGLE_SPREADSHEET_ID=""
VITE_GOOGLE_SPREADSHEET_TAB="Produtos"
VITE_GOOGLE_SPREADSHEET_CONTENT_TAB="Conteudo_Site"
